{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST; Port=5432; Database=YOUR_DB_NAME; Username=YOUR_DB_USER; Password=YOUR_DB_PASSWORD; SSL Mode=Require; Trust Server Certificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OcrApi": {
    "BaseUrl": "https://YOUR_OCR_API_URL",
    "ExtractEndpoint": "/api/v1/extract",
    "Language": "eng"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "GameAIAnalysis",
    "Audience": "GameAIAnalysisUsers",
    "DurationInMinutes": 60
  },
  "AllowedHosts": "*"
}
